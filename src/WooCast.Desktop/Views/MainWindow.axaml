<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WooCast.Desktop.ViewModels"
        x:Class="WooCast.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="WooCast"
        Icon="/Assets/woocast-icon.png"
        Width="1020"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        Background="{StaticResource WcBackgroundBrush}"
        FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter"
        RequestedThemeVariant="Dark"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══ Шапка ═══ -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="28,24,28,18">

            <!-- Знак берётся тем же рисунком, что и значок приложения: раньше здесь
                 была нарисованная буква, и она расходилась со значком в панели задач. -->
            <Image Grid.Column="0"
                   Width="38" Height="38"
                   Source="/Assets/woocast-icon.png"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="WooCast" FontSize="21" FontWeight="SemiBold" />

                <!-- Версия и новость об обновлении видны сразу: в настройках до них
                     пришлось бы прокручивать, а знать свою версию нужно с первого взгляда. -->
                <TextBlock Text="{Binding HeaderLine}"
                           Classes="muted"
                           FontSize="12" />
            </StackPanel>

            <Border Grid.Column="2" Classes="pill" VerticalAlignment="Center">
                <Border.Background>
                    <SolidColorBrush Color="#140E0E12" />
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#2A3340" />
                </Border.BorderBrush>
                <StackPanel Orientation="Horizontal" Spacing="9">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="#FFC24B" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ Содержимое ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,380" Margin="28,0,28,0">

            <!-- Левая колонка: устройства -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Grid.Column="0"
                               Text="ПРИСТАВКИ В СЕТИ"
                               Classes="section"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="ghost"
                            Padding="12,7"
                            FontSize="12"
                            Content="Обновить"
                            Command="{Binding RefreshCommand}" />
                </Grid>

                <Panel Grid.Row="1">
                    <ListBox ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                             IsVisible="{Binding HasDevices}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceViewModel">
                                <Border Classes="card">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="9">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="#35D6C4" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}"
                                                           Classes="name"
                                                           FontSize="15"
                                                           FontWeight="SemiBold" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Classes="muted"
                                                       FontSize="12" />
                                            <TextBlock Text="{Binding CapsText}"
                                                       Classes="muted"
                                                       FontSize="11" />
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Classes="pill"
                                                Padding="10,5"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsBusy}">
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="#FFC24B" />
                                            </Border.BorderBrush>
                                            <TextBlock Text="занято"
                                                       FontSize="11"
                                                       Foreground="#FFC24B" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Пустое состояние -->
                    <StackPanel IsVisible="{Binding !HasDevices}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="10"
                                MaxWidth="420">
                        <TextBlock Text="Ищу приставки…"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding DiscoveryHint}"
                                   Classes="muted"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Panel>

                <!-- Ручное подключение -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                    <TextBox Grid.Column="0"
                             PlaceholderText="Введите IP вручную, например 192.168.1.50"
                             Text="{Binding ManualAddress, Mode=TwoWay}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding ConnectManualCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1"
                            Classes="ghost"
                            Margin="10,0,0,0"
                            Content="Подключить"
                            Command="{Binding ConnectManualCommand}" />
                </Grid>
            </Grid>

            <!-- Правая колонка: настройки -->
            <Border Grid.Column="1" Classes="panel" Margin="22,0,0,0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <TextBlock Grid.Row="0"
                               Text="ПАРАМЕТРЫ ТРАНСЛЯЦИИ"
                               Classes="section"
                               Margin="0,0,0,16" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="11">

                            <StackPanel>
                                <TextBlock Text="Источник" Classes="field" />
                                <ComboBox ItemsSource="{Binding SourceOptions}"
                                          SelectedIndex="{Binding SourceKindIndex, Mode=TwoWay}" />
                                <TextBlock Text="{Binding SourceHint}"
                                           Classes="muted"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="2,6,0,0" />
                            </StackPanel>

                            <StackPanel IsVisible="{Binding IsWindowSource}">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                    <TextBlock Grid.Column="0"
                                               Text="Окно"
                                               Classes="field"
                                               Margin="0"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Classes="ghost"
                                            Padding="10,4"
                                            FontSize="11"
                                            Content="Обновить"
                                            Command="{Binding RefreshWindowsCommand}" />
                                </Grid>
                                <ComboBox ItemsSource="{Binding AvailableWindows}"
                                          SelectedIndex="{Binding SelectedWindowIndex, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel IsVisible="{Binding !IsWindowSource}">
                                <TextBlock Text="Монитор" Classes="field" />
                                <ComboBox ItemsSource="{Binding Displays}"
                                          SelectedIndex="{Binding SelectedDisplayIndex, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Разрешение" Classes="field" />
                                <ComboBox ItemsSource="{Binding ResolutionOptions}"
                                          SelectedIndex="{Binding SelectedResolutionIndex, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Частота кадров" Classes="field" />
                                <ComboBox ItemsSource="{Binding FpsOptions}"
                                          SelectedIndex="{Binding SelectedFpsIndex, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Качество" Classes="field" />
                                <ComboBox ItemsSource="{Binding QualityOptions}"
                                          SelectedIndex="{Binding SelectedQualityIndex, Mode=TwoWay}" />
                                <TextBlock Text="{Binding BitrateHint}"
                                           Classes="muted"
                                           FontSize="11"
                                           Margin="2,6,0,0" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Кодировщик" Classes="field" />
                                <ComboBox ItemsSource="{Binding EncoderOptions}"
                                          SelectedIndex="{Binding SelectedEncoderIndex, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ToggleSwitch IsChecked="{Binding DrawCursor, Mode=TwoWay}"
                                              OnContent=""
                                              OffContent=""
                                              VerticalAlignment="Center" />
                                <TextBlock Text="Показывать курсор"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ToggleSwitch IsChecked="{Binding AudioEnabled, Mode=TwoWay}"
                                              OnContent=""
                                              OffContent=""
                                              VerticalAlignment="Center" />
                                <TextBlock Text="Передавать звук"
                                           FontSize="13"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="160 кбит/с"
                                           Classes="muted"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Управление с контроллера, подключённого к приставке
                                 или телефону: состояние уходит на ПК и подаётся в игру
                                 через виртуальный геймпад. -->
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ToggleSwitch IsChecked="{Binding GamepadEnabled, Mode=TwoWay}"
                                                  OnContent=""
                                                  OffContent=""
                                                  VerticalAlignment="Center" />
                                    <TextBlock Text="Управление с приёмника"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <ComboBox ItemsSource="{Binding GamepadKindOptions}"
                                          SelectedIndex="{Binding GamepadKindIndex, Mode=TwoWay}"
                                          IsEnabled="{Binding GamepadEnabled}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Text="{Binding GamepadHint}"
                                           Classes="muted"
                                           FontSize="11"
                                           TextWrapping="Wrap" />

                                <!-- Драйвер виртуального геймпада: без него игра
                                     не увидит контроллер. Установщик лежит в поставке.
                                     Кнопка видна всегда: когда драйвер уже стоит, она
                                     неактивна, а состояние написано рядом. -->
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Установить драйвер"
                                            Command="{Binding InstallGamepadDriverCommand}"
                                            IsEnabled="{Binding CanInstallGamepadDriver}"
                                            FontSize="12" />
                                    <TextBlock Text="{Binding GamepadDriverText}"
                                               Classes="muted"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Обновления берутся из выпусков репозитория на GitHub:
                                 своего сервера для этого не нужно. Проверка идёт молча. -->
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Проверить обновления"
                                            Command="{Binding CheckUpdateCommand}"
                                            FontSize="12" />

                                    <Button Content="Скачать и обновить"
                                            Command="{Binding DownloadAndUpdateCommand}"
                                            IsVisible="{Binding UpdateAvailable}"
                                            IsEnabled="{Binding IsUpdating, Converter={x:Static BoolConverters.Not}}"
                                            FontSize="12" />

                                    <Button Content="Страница выпуска"
                                            Command="{Binding OpenUpdatePageCommand}"
                                            IsVisible="{Binding UpdateAvailable}"
                                            FontSize="12" />
                                </StackPanel>

                                <TextBlock Text="{Binding UpdateText}"
                                           Classes="muted"
                                           FontSize="11"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Поправка синхронизации: задержки кодировщиков видео и звука
                                 различаются, и разницу проще подстроить на слух. -->
                            <!-- Компромисс между плавностью и задержкой: ключевой кадр в разы
                                 больше обычного, и его передача занимает сотни миллисекунд.
                                 Запас прячет этот всплеск, но добавляет задержку. -->
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Запас плавности" Classes="field" />
                                    <TextBlock Text="{Binding BufferText}"
                                               Classes="muted"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Slider Minimum="0"
                                        Maximum="600"
                                        TickFrequency="50"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding BufferMs, Mode=TwoWay}" />
                                <TextBlock Text="применяется при запуске трансляции"
                                           Classes="muted"
                                           FontSize="11" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Задержка звука" Classes="field" />
                                    <TextBlock Text="{Binding AudioDelayText}"
                                               Classes="muted"
                                               FontSize="11"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Slider Minimum="-500"
                                        Maximum="500"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="True"
                                        IsEnabled="{Binding AudioEnabled}"
                                        Value="{Binding AudioDelayMs, Mode=TwoWay}" />
                                <TextBlock Text="применяется при запуске трансляции"
                                           Classes="muted"
                                           FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Spacing="10" Margin="0,16,0,0">
                        <!-- Что умеет выбранная приставка; жёлтым — если параметры пришлось подрезать. -->
                        <TextBlock Text="{Binding CapabilityNote}"
                                   Foreground="#FFC24B"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding CapabilityClamped}" />

                        <TextBlock Text="{Binding CapabilityNote}"
                                   Classes="muted"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !CapabilityClamped}" />

                        <Button Classes="primary"
                                Content="▶  Транслировать"
                                IsVisible="{Binding !IsStreaming}"
                                IsEnabled="{Binding !IsBusy}"
                                Command="{Binding ToggleStreamingCommand}" />

                        <Button Classes="danger"
                                Content="■  Остановить"
                                IsVisible="{Binding IsStreaming}"
                                Command="{Binding ToggleStreamingCommand}" />

                        <TextBlock Text="{Binding LastError}"
                                   Foreground="#FF5C5C"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding LastError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <TextBlock Text="{Binding AdaptationNote}"
                                   Foreground="#FFC24B"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding AdaptationNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ Подвал ═══ -->
        <Border Grid.Row="2"
                Margin="0,18,0,0"
                Padding="28,12"
                Background="#0B0E14"
                BorderBrush="{StaticResource WcOutlineBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding EncoderText}"
                           Classes="muted"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding MetricsText}"
                           Classes="metric"
                           Margin="24,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="MIT"
                           Classes="muted"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
