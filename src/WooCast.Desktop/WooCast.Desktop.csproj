<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Захват опирается на Windows-фичи, поэтому и приложение, и библиотека захвата
         нацелены на Windows с версией: она открывает проекции Windows SDK, нужные
         для Windows.Graphics.Capture. При добавлении Linux-отправителя появится вторая TFM. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>WooCast.Desktop</RootNamespace>
    <AssemblyName>WooCast</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Значок окна и панели задач. Файл содержит набор размеров: с единственным
         изображением система растягивает его, и в панели задач значок выглядит мутным.
         Значок собирается скриптом tools/make-icons.py. -->
    <ApplicationIcon>..\..\assets\icon\woocast.ico</ApplicationIcon>

    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- Значок окна берётся из того же рисунка, что и значок приложения:
         собирается скриптом tools/make-icons.py. -->
    <AvaloniaResource Include="..\..\assets\icon\woocast-icon-256.png"
                      Link="Assets\woocast-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WooCast.Protocol\WooCast.Protocol.csproj" />
    <ProjectReference Include="..\WooCast.Capture\WooCast.Capture.csproj" />
  </ItemGroup>

</Project>
